{
  "name": "next-step",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "type": "module",
  "scripts": {
    "start": "bun apps/tui/src/main.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "nx run tui-app:build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run build",
    "install:local": "bun run build && install -Dm755 dist/next-step \"$HOME/.local/bin/next-step\""
  },
  "devDependencies": {
    "@nx/oxlint": "23.2.1",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "nx": "23.2.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.2"
}
